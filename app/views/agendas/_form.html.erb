<%= form_with(model: agenda) do |form| %> <% if agenda.errors.any? %>
    <div class="agenda-form-errors">
      <div class="agenda-error-header"> <i class="bi bi-exclamation-triangle-fill"></i>
        <div>
          <h5>No se pudo guardar la agenda</h5>
          <p> Revisa los siguientes campos: </p>
        </div>
      </div>
      <ul> <% agenda.errors.full_messages.each do |mensaje| %>
          <li><%= mensaje %></li>
        <% end %> </ul>
    </div>
  <% end %>
  <div class="agenda-info-grid"> <!-- Fecha inicio -->
    <div class="agenda-info-item">
      <div class="agenda-info-icon"> <i class="bi bi-calendar-event"></i> </div>
      <div class="agenda-edit-field"> <%= form.label :fecha_inicio, "Fecha de inicio" %> <%= form.date_field :fecha_inicio, class: "form-control" %> </div>
    </div>
    <!-- Fecha fin -->
    <div class="agenda-info-item">
      <div class="agenda-info-icon"> <i class="bi bi-calendar-check"></i> </div>
      <div class="agenda-edit-field"> <%= form.label :fecha_fin, "Fecha de fin" %> <%= form.date_field :fecha_fin, class: "form-control" %> </div>
    </div>
    <!-- Médico -->
    <div class="agenda-info-item">
      <div class="agenda-info-icon"> <i class="bi bi-person"></i> </div>
      <div class="agenda-edit-field"> <%= form.label :user_id, "Médico" %> <%= form.collection_select :user_id, @medicos, :id, :nombre, { prompt: "Selecciona un médico" }, { class: "form-select" } %> </div>
    </div>
    <!-- Número de citas -->
    <div class="agenda-info-item">
      <div class="agenda-info-icon"> <i class="bi bi-people"></i> </div>
      <div class="agenda-edit-field"> <%= form.label :num_citas, "Número de citas" %> <%= form.number_field :num_citas, class: "form-control", min: 1 %> </div>
    </div>
    <!-- Hora -->
    <div class="agenda-info-item">
      <div class="agenda-info-icon"> <i class="bi bi-clock"></i> </div>
      <div class="agenda-edit-field"> <%= form.label :hora_inicio, "Hora de inicio" %> <%= form.time_field :hora_inicio, class: "form-control" %> </div>
    </div>
    <!-- Estado -->
    <div class="agenda-info-item">
      <div class="agenda-edit-field"> <%= form.label :activo, "Estado" %> <label class="agenda-switch">
          <%= form.check_box :activo %> <span class="agenda-switch-slider"></span> <span class="agenda-switch-text"> Agenda activa </span> </label> </div>
    </div>
  </div>
  <!-- Botones -->
  <div class="agenda-form-submit"> 
    <%= link_to agenda_path(agenda), class: "btn-agenda-secondary" do %> 
      <i class="bi bi-arrow-left"></i> Cancelar 
    <% end %> 
    <%= form.submit "Guardar cambios", class:  "btn-agenda-secondary"  %> 
  </div>
<% end %>