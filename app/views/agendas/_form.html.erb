<%= form_with(model: agenda) do |form| %>
  <% if agenda.errors.any? %>
    <div class="agenda-form-errors">
      <div class="agenda-error-header">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <div>
          <h5>
            No se pudo guardar la agenda
          </h5>
          <p>
            Revisa los siguientes campos:
          </p>
        </div>
      </div>
      <ul>
        <% agenda.errors.each do |error| %>
          <li>
            <%= error.full_message %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="agenda-fields">
    <!-- Fecha de inicio -->
    <div class="agenda-field">
      <%= form.label :fecha_inicio, "Fecha de inicio" %>
      <%= form.date_field :fecha_inicio,
          class: "form-control" %>
    </div>
    <!-- Fecha de fin -->
    <div class="agenda-field">
      <%= form.label :fecha_fin, "Fecha de fin" %>
      <%= form.date_field :fecha_fin,
          class: "form-control" %>
    </div>
    <!-- Médico -->
    <div class="agenda-field">
      <%= form.label :user_id, "Médico" %>
      <%= form.collection_select :user_id,
          User.all,
          :id,
          :nombre,
          { prompt: "Selecciona un médico" },
          { class: "form-select" } %>
    </div>
    <!-- Número de citas -->
    <div class="agenda-field">
      <%= form.label :num_citas, "Número de citas" %>
      <%= form.number_field :num_citas,
          class: "form-control",
          min: 1 %>
    </div>
    <!-- Hora -->
    <div class="agenda-field">
      <%= form.label :hora_inicio, "Hora de inicio" %>
      <%= form.time_field :hora_inicio,
          class: "form-control" %>
    </div>
    <!-- Estado -->
    <div class="agenda-field agenda-field-estado">
      <%= form.label :activo, "Estado" %>
      <label class="agenda-switch">
        <%= form.check_box :activo %>
        <span class="agenda-switch-slider"></span>
        <span class="agenda-switch-text">
          Agenda activa
        </span>
      </label>
    </div>
  </div>
  <div class="agenda-form-submit">
    <%= form.submit agenda.new_record? ? "Crear agenda" : "Guardar cambios",
        class: "btn-agenda-primary" %>
  </div>
<% end %>