<div id="<%= dom_id @agenda %>" class="agenda-detalle">
  <div class="agenda-detalle-header">
    <div class="agenda-detalle-header-title">
    <h2>
      <i class="bi bi-pencil-square"></i>
      Editar agenda
    </h2>
    <div class="relacion-acciones">
      <%= link_to relacion_agenda_plantillas_editar_relaciones_path(agenda: @agenda.id),
              class: "btn-editar-relacion" do %>
        <i class="bi bi-pencil-square"></i>
        Editar Relaciones
      <% end %>
    </div>
  </div>
  </div>
  <div class="agenda-detalle-card">
    <%= render "form", agenda: @agenda %>
  </div>
</div>