<div class="agendas-container">
  <div class="agendas-header">
    <div>
      <h1>
        <i class="bi bi-calendar2-week"></i>
        Agendas
      </h1>
      <p>
        Consulta y administra las agendas registradas.
      </p>
    </div>
    <%= link_to new_agenda_path, class: "btn-nueva-agenda" do %>
      <i class="bi bi-plus-lg"></i>
      Nueva agenda
    <% end %>
  </div>
  <div class="agendas-card">
    <div class="agendas-table-header">
      <h5>
        <i class="bi bi-list-ul"></i>
        Agendas registradas
      </h5>
    </div>
    <div class="agendas-table-container">
      <table class="agendas-table">
        <thead>
          <tr>
            <th>Fecha Inicio</th>
            <th>Fecha Fin</th>
            <th>Médico</th>
            <th>Citas</th>
            <th>Hora de inicio</th>
            <th>Estado</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if @agendas.any? %>
            <% @agendas.each do |agenda| %>
              <tr>
                <td class="agenda-fecha">
                  <%= agenda.fecha_inicio.strftime("%d/%m/%Y") %>
                </td>
                <td class="agenda-fecha">
                  <%= agenda.fecha_fin.strftime("%d/%m/%Y") %>
                </td>
                <td class="agenda-medico">
                  <%= agenda.user.nombre %>
                </td>
                <td>
                  <%= agenda.num_citas %>
                </td>
                <td>
                  <%= agenda.hora_inicio.strftime("%H:%M") %>
                </td>
                <td>
                  <% if agenda.activo %>
                    <span class="agenda-estado agenda-activa">
                      Activa
                    </span>
                  <% else %>
                    <span class="agenda-estado agenda-inactiva">
                      Inactiva
                    </span>
                  <% end %>
                </td>
                <td>
                  <div class="agenda-actions">
                    <%= link_to agenda_path(agenda),
                        class: "btn-agenda-action",
                        title: "Ver agenda" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                    <%= link_to edit_agenda_path(agenda),
                        class: "btn-agenda-action",
                        title: "Editar agenda" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6">
                <div class="sin-agendas">
                  <i class="bi bi-calendar-x"></i>
                  <h5>No hay agendas registradas</h5>
                  <p>
                    Actualmente no existen agendas para mostrar.
                  </p>
                  <%= link_to new_agenda_path,
                      class: "btn-nueva-agenda" do %>
                    <i class="bi bi-plus-lg"></i>
                    Crear primera agenda
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>