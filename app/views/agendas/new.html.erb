<div class="container-fluid py-4" data-controller="agenda">
  <!-- ENCABEZADO -->
  <div class="agendas-header d-flex align-items-center justify-content-between">
    <div class="d-flex align-items-center gap-3">
      <h1 class="mb-0">
        <i class="bi bi-calendar-plus"></i>
        Nueva agenda
      </h1>      
    </div>
    <%= link_to agendas_path, class: "btn-regresar-agenda" do %>
      <i class="bi bi-arrow-left"></i>
      Regresar
    <% end %>
  </div>
  <!-- FORMULARIO -->
  <div class="agenda-form-card">
    <div class="agenda-form-header">
      <i class="bi bi-calendar2-week"></i>
      <div>
        <h4>Información de la agenda</h4>
        <span>Completa los datos para registrar la agenda.</span>
      </div>
    </div>
    <%= form_with model: @agenda do |form| %>
      <% if @agenda.errors.any? %>
        <div class="alert alert-danger">
          <strong>
            No se pudo crear la agenda:
          </strong>
          <ul class="mb-0 mt-2">
            <% @agenda.errors.full_messages.each do |message| %>
              <li>
                <%= message %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <div class="row g-4">
        <!-- FECHA INICIO -->
        <div class="col-md-6">
          <%= form.label :fecha_inicio,
                         "Fecha de inicio",
                         class: "form-label" %>
          <div class="input-icon">
            <i class="bi bi-calendar-event"></i>
            <%= form.date_field :fecha_inicio,
                                class: "form-control" %>
          </div>
        </div>
        <!-- FECHA FIN -->
        <div class="col-md-6">
          <%= form.label :fecha_fin,
                         "Fecha de finalización",
                         class: "form-label" %>
          <div class="input-icon">
            <i class="bi bi-calendar-check"></i>
            <%= form.date_field :fecha_fin,
                                class: "form-control" %>
          </div>
        </div>        
      </div>
      <!-- BOTONES -->
      <div class="form-actions">
        <%= link_to agendas_path, class: "btn-cancelar-agenda" do %>
          <i class="bi bi-x-lg"></i>
          Cancelar
        <% end %>
        <%= form.submit "Crear Agenda",
                        class: "btn-guardar-agenda" %>
      </div>
    <% end %>
  </div>
</div>