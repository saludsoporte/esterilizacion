<%= turbo_stream.replace "div_dia" do %>
    <div id="div_dia" class="col-md-4">
        <label class="form-label" for="relacion_agenda_plantilla_id" >Dias disponibles</label>
        <select class="form-select" id="dia_disponible">
            <% relaciones.each do |rel|%>
                <option value="<%= rel[1].to_s+" - "+rel[0].to_s %>"><%= rel[1].to_s+" - "+rel[0].to_s %></option>
            <% end %>
        </select>        
    </div>
<% end %>
