<div id="<%= dom_id cita %>" class="cita-detalle">
  <!-- ENCABEZADO -->
  <div class="cita-detalle-header">
    <div>
      <span class="cita-detalle-label">CITA</span>
      <h2>Información de la cita</h2>
    </div>
    <span class="cita-estado <%= cita.estado.to_s.downcase %>">
      <%= cita.estado.presence || "Pendiente" %>
    </span>
  </div>
  <!-- INFORMACIÓN DE LA CITA -->
  <div class="cita-seccion">
    <h3>📅 Datos de la cita</h3>
    <div class="cita-grid">
      <div class="cita-dato">
        <span>Fecha de creacion</span>
        <strong>
          <%= cita.fecha.present? ? cita.fecha.strftime("%d/%m/%Y") : "No especificada" %>
        </strong>
      </div>
      <div class="cita-dato">
        <span>Dia</span>
        <strong>
          <%= cita.relacion_agenda_plantilla.dia_cita %>
        </strong>
      </div>
      <div class="cita-dato">
        <span>Hora</span>
        <strong>
          <%= cita.detalle_mesa.horario.strftime("%H:%M") %>
        </strong>
      </div>
      <div class="cita-dato">
        <span>Motivo de la cita</span>
        <strong><%= cita.motivo.presence || "No especificado" %></strong>
      </div>
      <div class="cita-dato">
        <span>Médico</span>
        <strong><%= cita.medico.presence || "No asignado" %></strong>
      </div>
      <div class="cita-dato">
        <span>Vacunación</span>
        <strong>
          <% if cita.vacuna %>
            <span class="vacuna-confirmada">✓</span>
          <% else %>
            <span class="vacuna-no-confirmada">✕</span>
          <% end %>
        </strong>
      </div>
    </div>
  </div>
  <!-- PROPIETARIO -->
  <div class="cita-seccion">
    <h3>👤 Datos del propietario</h3>
    <div class="cita-grid">
      <div class="cita-dato cita-dato-grande">
        <span>Nombre completo</span>
        <strong>
          <%= [
        cita.nombre_dueño,
        cita.apellido_p_dueño,
        cita.apellido_m_dueño
      ].compact_blank.join(" ") %>
        </strong>
      </div>
      <div class="cita-dato">
        <span>CURP</span>
        <strong><%= cita.curp.presence || "No especificada" %></strong>
      </div>
      <div class="cita-dato">
        <span>Teléfono</span>
        <strong><%= cita.telefono.presence || "No especificado" %></strong>
      </div>
      <div class="cita-dato">
        <span>Sexo</span>
        <strong><%= cita.sexo_definido.presence || "No especificado" %></strong>
      </div>
      <div class="cita-dato">
        <span>Edad</span>
        <strong>
          <%= cita.edad_dueño.present? ? "#{cita.edad_dueño} años" : "No especificada" %>
        </strong>
      </div>
    </div>
  </div>
  <!-- MASCOTA -->
  <div class="cita-seccion">
    <h3>🐾 Datos de la mascota</h3>
    <div class="cita-mascota">
      <div class="cita-mascota-nombre">
        <span>Nombre de la mascota</span>
        <strong><%= cita.nombre_mascota.presence || "Sin nombre" %></strong>
      </div>
      <div class="cita-grid">
        <div class="cita-dato">
          <span>Especie</span>
          <strong><%= cita.especie.presence || "No especificada" %></strong>
        </div>
        <div class="cita-dato">
          <span>Raza</span>
          <strong><%= cita.raza.presence || "No especificada" %></strong>
        </div>
        <div class="cita-dato">
          <span>Sexo</span>
          <strong><%= cita.sexo.presence || "No especificado" %></strong>
        </div>
        <div class="cita-dato">
          <span>Edad</span>
          <strong>
            <%= cita.edad_mascota.present? ? "#{cita.edad_mascota} años" : "No especificada" %>
          </strong>
        </div>
      </div>
    </div>
  </div>
  <!-- DOMICILIO -->
  <div class="cita-seccion">
    <h3>📍 Domicilio</h3>
    <div class="cita-domicilio">
      <div class="cita-dato">
        <span>Calle</span>
        <strong><%= cita.calle.presence || "No especificada" %></strong>
      </div>
      <div class="cita-dato">
        <span>Colonia</span>
        <strong><%= cita.colonia.presence || "No especificada" %></strong>
      </div>
      <div class="cita-dato">
        <span>Localidad</span>
        <strong><%= cita.localidad.presence || "No especificada" %></strong>
      </div>
      <div class="cita-dato">
        <span>Municipio</span>
        <strong><%= cita.municipio.presence || "No especificado" %></strong>
      </div>
    </div>
  </div>
</div>
