<div class="cita-formulario" data-controller="citas">
  <div class="cita-titulo">
    <h1>Registrar cita</h1>
    <p>Ingresa los datos del propietario, domicilio y mascota</p>
  </div>
  <%= form_with(model: cita, local: true) do |form| %> <% if cita.errors.any? %>
      <div class="alert alert-danger">
        <h5> <%= pluralize(cita.errors.count, "error") %> impidieron guardar la cita: </h5>
        <ul class="mb-0"> <% cita.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %> </ul>
      </div>
    <% end %> <!-- ========================================== DATOS DEL PROPIETARIO ========================================== -->
    <div class="cita-card">
      <div class="cita-card-header"> <i class="bi bi-person-fill"></i>
        <h5>Datos del propietario</h5>
      </div>
      <div class="cita-card-body">
        <div class="row g-3">
          <div class="col-md-4"> <%= form.label :nombre_dueño, "Nombre", class: "form-label" %> <%= form.text_field :nombre_dueño, class: "form-control" %> </div>
          <div class="col-md-4"> <%= form.label :apellido_p_dueño, "Apellido paterno", class: "form-label" %> <%= form.text_field :apellido_p_dueño, class: "form-control" %> </div>
          <div class="col-md-4"> <%= form.label :apellido_m_dueño, "Apellido materno", class: "form-label" %> <%= form.text_field :apellido_m_dueño, class: "form-control" %> </div>
          <div class="col-md-4"> <%= form.label :sexo_dueño, "Sexo", class: "form-label" %> <%= form.select :sexo_dueño, [["Masculino", "M"], ["Femenino", "F"]], { prompt: "Selecciona..." }, class: "form-select" %> </div>
          <div class="col-md-4"> <%= form.label :edad_dueño, "Edad", class: "form-label" %> <%= form.number_field :edad_dueño, min: 1, class: "form-control" %> </div>
          <div class="col-md-4"> <%= form.label :telefono, "Teléfono", class: "form-label" %> <%= form.telephone_field :telefono, class: "form-control" %> </div>
          <div class="col-md-4"> <%= form.label :curp, "CURP", class: "form-label" %> <%= form.text_field :curp, class: "form-control" %> </div>
          <div class="col-md-4"><%= form.label :email, "Correo", class: "form-label" %> <%= form.email_field :email, class: "form-control" %></div>
          <div class="col-md-4"><%= form.label :fecha, "Fecha", class: "form-label" %> <%= form.date_field :fecha,value:Time.now() ,class: "form-control" %></div>
        </div>
      </div>
    </div>
    <!-- ========================================== DOMICILIO ========================================== -->
    <div class="cita-card">
      <div class="cita-card-header"> <i class="bi bi-house-fill"></i>
        <h5>Domicilio</h5>
      </div>
      <div class="cita-card-body">
        <div class="row g-3">
          <div class="col-md-6"> <%= form.label :calle, "Calle", class: "form-label" %> <%= form.text_field :calle, class: "form-control" %> </div>
          <div class="col-md-6"> <%= form.label :colonia, "Colonia", class: "form-label" %> <%= form.text_field :colonia, class: "form-control" %> </div>
          <div class="col-md-4"> <%= form.label :localidad, "Localidad", class: "form-label" %> <%= form.text_field :localidad, class: "form-control" %> </div>
          <div class="col-md-4"> <%= form.label :municipio, "Municipio", class: "form-label" %> <%= form.text_field :municipio, class: "form-control" %> </div>
        </div>
      </div>
    </div>
    <!-- ========================================== DATOS DE LA MASCOTA ========================================== -->    
    <div class="cita-card">
      <div class="cita-card-header"> <i class="bi bi-heart-fill"></i>
        <h5>Datos de la mascota</h5>
      </div>
      <div class="cita-card-body">
        <div class="row g-3">
          <div class="col-md-6"> <%= form.label :nombre_mascota, "Nombre de la mascota", class: "form-label" %> <%= form.text_field :nombre_mascota, class: "form-control" %> </div>
          <div class="col-md-3"> <%= form.label :especie, "Especie", class: "form-label" %> <%= form.select :especie, [["Perro", "Perro"], ["Gato", "Gato"]], { prompt: "Selecciona..." }, class: "form-select" %> </div>
          <div class="col-md-3"> <%= form.label :sexo, "Sexo", class: "form-label" %> <%= form.select :sexo, [["Macho", "Macho"], ["Hembra", "Hembra"]], { prompt: "Selecciona..." }, class: "form-select" %> </div>
          <div class="col-md-4"> <%= form.label :edad_mascota, "Edad", class: "form-label" %> <%= form.text_field :edad_mascota, class: "form-control" %> </div>
          <div class="col-md-4"> <%= form.label :raza, "Raza", class: "form-label" %> <%= form.text_field :raza, class: "form-control" %> </div>
          <div class="col-md-4"> <%= form.label :vacuna, "¿Cuenta con vacuna?", class: "form-label" %> <%= form.select :vacuna, [["Sí", true], ["No", false]], { prompt: "Selecciona..." }, class: "form-select" %> </div>
          <div class="col-12"> <%= form.label :motivo, "Motivo de la cita", class: "form-label" %> <%= form.text_area :motivo, rows: 3, class: "form-control" %> </div>
        </div>
      </div>
    </div>
    <!-- ========================================== DATOS DE LA CITA ========================================== -->
    <div class="cita-card cita-agenda">
      <div class="cita-card-header"> <i class="bi bi-calendar-check"></i>
        <h5>Datos de la cita</h5>
      </div>
      <div class="cita-card-body">
        <div class="row g-3">          
          <div id="div_dia" class="col-md-4"> 
          </div>
          <div id="div_hora"  class="col-md-4"> <%= form.label :detalle_mesa_id, "Horario", class: "form-label" %> <%= form.collection_select :detalle_mesa_id, @detalles_mesa, :id, :horario, { prompt: "Selecciona un horario..." }, class: "form-select" %> </div>
        </div>
      </div>
    </div>
    <!-- ========================================== BOTONES ========================================== -->
    <div class="cita-acciones"> <%= link_to "Cancelar", citas_path, class: "btn btn-cancelar-cita" %> <%= form.submit "Registrar cita", class: "btn btn-registrar-cita" %> </div>
  <% end %> </div>