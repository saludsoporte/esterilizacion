<!-- TEMPLATE PARA NUEVOS DETALLES -->
<template data-mesas-target="template">
  <div class="form-mesa hstack gap-3 mb-3 p-3 border rounded">
    <div class="opciones-checkbox">
      <label class="opcion-checkbox">
        <input
                  type="radio"
                  name="mesa[detalle_mesas_attributes][INDEX][tipo]"
                  value="F_H">
          <span>
            Felino Hembra
          </span>
        </label>
        <label class="opcion-checkbox">
