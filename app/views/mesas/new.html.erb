<%= turbo_frame_tag "modal" do %>
  <div class="configurar-mesa" data-controller="mesas">
    <%= form_with model: @mesa,method: :post, data: {turbo_frame: "tabla_mesas" },id: "mesa-form"     do |f| %>
      <div class="mb-3">
        <%= f.label :nombre, "Nombre de la mesa", class: "form-label fw-bold" %>
        <%= f.text_field :nombre,
        class: "form-control",
        placeholder: "Ej. Mesa 1" %>
      </div>
      <br>
      <!-- DETALLES -->
      <div class="card" >
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0">
            Detalles de la mesa
          </h5>
          <button type="button"
                class="btn btn-primary"
                data-action="click->mesas#agregarDetalle">
            <i class="bi bi-plus-lg"></i>
            Agregar detalle
          </button>
        </div>
        <div class="card-body">
          <!-- DETALLES EXISTENTES -->
          <div data-mesas-target="detalles">
            <%= f.fields_for :detalle_mesas do |detalle| %>
              <%= render "detalle_mesa",detalle: detalle %>
            <% end %>
          </div>
        </div>
        <%= render "template_detalle_mesa" %>
      </div>
      <!-- GUARDAR -->
      <div class="mt-3">
        <button type="submit"
          form="mesa-form"
          class="btn-agregar-mesa">
          Guardar mesa
        </button>       
      </div>
    <% end %>
  </div>
<% end %>