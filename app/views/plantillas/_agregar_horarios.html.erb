<div id="agregar_nuevos_horarios">
  <div class="mesas-configuracion" data-controller="plantillas">
    <input id="index" type="number" value=0 >
    <% mesas.each do |mesa| %>
      <div class="mesa-card mb-3"
         data-mesa-id="<%= mesa.id %>">
        <!-- ENCABEZADO -->
        <div class="mesa-header">
          <div class="mesa-header-info">
            <h5>
              <i class="bi bi-grid-3x3-gap-fill"></i>
              <%= mesa.nombre_mesa %>
            </h5>
          </div>
          <div class="mesa-header-acciones" data-plantillas-target="mesa">
            <button type="button"
                  class="btn btn-outline-primary btn-sm"
                  data-action="click->plantillas#agregarDetalle"
              data-mesa-id="<%= mesa.id %>">
              <i class="bi bi-plus-lg"></i>
              Agregar horario
            </button>
          </div>
        </div>
        <!-- TABLA DE HORARIOS -->
        <div class="mesa-tabla-container">
          <div class="card" >
            <div class="card-body">              
              <!-- DETALLES EXISTENTES -->              
                <%= turbo_frame_tag "template"+mesa.id.to_s do %>
                <% end %>
              </div>
            </div>
          </div>
          <!-- CONTENEDOR PARA NUEVOS HORARIOS -->
          <div data-pl-target="nuevosDetalles" class="mesa-nuevos-detalles">
          </div>          
        </div>
      <% end %>
    </div>  
  </div>
