<div id="agregar_nuevos_horarios">
  <div class="mesas-configuracion" data-controller="plantillas">
    <% mesas.each do |mesa| %>
      <div class="mesa-card mb-3"
         data-mesa-id="<%= mesa.id %>">
        <!-- ENCABEZADO -->
        <div class="mesa-header">
          <div class="mesa-header-info">
            <h5>
              <i class="bi bi-grid-3x3-gap-fill"></i>
              <%= mesa.nombre_mesa %>
            </h5>
          </div>
          <div class="mesa-header-acciones">
            <button type="button"
                  class="btn btn-outline-primary btn-sm"
                  data-action="click->plantillas#agregarDetalle"
              data-mesa-id="<%= mesa.id %>">
              <i class="bi bi-plus-lg"></i>
              Agregar horario
            </button>
          </div>
        </div>
        <!-- TABLA DE HORARIOS -->
        <div class="mesa-tabla-container">
          <div class="card" >
            <div class="card-body">
              <!-- DETALLES EXISTENTES -->
              <div data-mesas-target="detalles">
              </div>
              <%# turbo_frame_tag "template" do %>
                <%# end %>
              </div>
            </div>
          </div>
          <!-- CONTENEDOR PARA NUEVOS HORARIOS -->
          <div data-mesas-target="nuevosDetalles"
           class="mesa-nuevos-detalles">
          </div>
          <%= render "template_detalle_mesa" %>
        </div>
      <% end %>
    </div>
    Numero de mesas seleccionadas: <%= mesas.count %>
  </div>
