
<div class="container mt-4">
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">    
    <div class="table-responsive px-3">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="text-center py-3" style="width: 100px;">
              Seleccionar
            </th>
            <th class="py-3">Nombre de la mesa</th>
          </tr>
        </thead>
        <tbody>
          <% @mesas.each do |mesa| %>
            <tr>
              <td >
                <%= check_box_tag "plantilla[mesa_ids][]",
                  mesa.id,
                  false,                  
                  id: "mesa_select_#{mesa.id}",
                  data: {
                    action: "change->plantillas#seleccionarMesa",
                    plantillas_target: "mesa",
                    nombre: mesa.nombre_mesa
                  }
                %>
              </td>
              <td>
                <span class="fw-semibold">
                  <%= mesa.nombre_mesa %>
                </span>
              </td>
            </tr>
          <% end %>
          <% if @mesas.empty? %>
            <tr>
              <td colspan="3" class="text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted"></i>
                <p class="text-muted mt-2 mb-0">
                  No hay mesas disponibles.
                </p>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>    
  </div>
</div>