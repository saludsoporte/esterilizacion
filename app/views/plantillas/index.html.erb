<div class="container plantillas-container">
  <div class="plantillas-header">
    <div>
      <h1>
        <i class="bi bi-file-earmark-text-fill"></i>
        Plantillas
      </h1>
      <p>
        Administra las plantillas disponibles en el sistema.
      </p>
    </div>
    <%= link_to new_plantilla_path, class: "btn-nueva-plantilla" do %>
      <i class="bi bi-plus-lg"></i>
      Crear plantilla
    <% end %>
  </div>
  <% if @plantillas.any? %>
    <div class="row g-4">
      <% @plantillas.each do |plantilla| %>
        <div class="container py-4">
          <!-- ENCABEZADO DE LA PLANTILLA -->
          <div class="plantilla-header mb-4">
            <div>
              <h1>
                <i class="bi bi-grid-3x3-gap-fill"></i>
                <%= plantilla.nombre %>
              </h1>
              <p class="text-muted mb-0">
                Detalle de mesas y distribución por día
              </p>
            </div>
            <%= link_to plantillas_path, class: "btn btn-secondary" do %>
              <i class="bi bi-arrow-left"></i>
              Regresar
            <% end %>
          </div>
          <!-- DÍAS -->
          <% dias = plantilla.detalle_plantillas.group_by(&:dia) %>
          <% dias.each do |dia, detalles| %>
            <div class="dia-card mb-4 ">
              <!-- TÍTULO DEL DÍA -->
              <div class="dia-header">
                <h3>
                  <i class="bi bi-calendar3"></i>
                  <%= dia.upcase %>
                </h3>
                <span class="badge bg-primary">
                  <%= detalles.count %> mesas
                </span>
              </div>
              <!-- MESAS -->
              <div class="row g-3 p-3">
                <% detalles.each do |detalle| %>
                  <% mesa = detalle.mesa %>
                  <div class="col-md-6 col-lg-4">
                    <div class="mesa-card ">
                      <div class="accordion-item">
                      <!-- ENCABEZADO MESA -->
                      <div class="accordion-header">
                        <button
                            class="accordion-button collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#acordion<%= detalle.id %>"
                            aria-expanded="false"
                            aria-controls="acordion<%= detalle.id %>">
                          <h6>
                            <%= mesa.nombre_mesa %>
                          </h6>
                        </button>
                      </div>
                      <!-- INFORMACIÓN DE LA MESA -->
                      <div
                          id="acordion<%= detalle.id %>"
                          class="accordion-collapse collapse">
                        <div class="accordion-body">
                          <!-- ENCABEZADOS -->
                          <div class="row">
                            <div class="col-md-6">
                              <div class="mesa-dato">
                                <span>
                                  Paciente
                                </span>
                              </div>
                            </div>
                            <div class="col-md-6">
                              <div class="mesa-dato">
                                <span>
                                  Horario
                                </span>
                              </div>
                            </div>
                          </div>
                          <!-- DETALLES DE LA MESA -->
                          <% mesa.detalle_mesas.each do |detalle_mesa|%>
                            <div class="row">
                              <!-- PACIENTE -->
                              <div class="col-md-6">
                                <div class="mesa-dato">
                                  <strong>
                                    <%= detalle_mesa.paciente+detalle_mesa.sexo %>
                                  </strong>
                                </div>
                              </div>
                              <!-- HORARIO -->
                              <div class="col-md-6">
                                <div class="mesa-dato">
                                  <strong>
                                    <%= detalle_mesa.horario&.strftime("%H:%M") %>
                                  </strong>
                                </div>
                              </div>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="sin-plantillas">
      <i class="bi bi-file-earmark-x"></i>
      <h3>No hay plantillas</h3>
      <p>
        Actualmente no existen plantillas registradas.
      </p>
    </div>
  <% end %>
</div>