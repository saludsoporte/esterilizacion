<div class="wizard"  data-controller="plantillas">
  <!-- Indicador de pasos -->
  <div class="wizard-steps">
    <div class="wizard-step active" data-plantillas-target="stepIndicator">
      <span>1</span>
      <small>Nombre de la Plantilla</small>
    </div>
    <div class="wizard-line"></div>
    <div class="wizard-step" data-plantillas-target="stepIndicator">
      <span>2</span>
      <small>Agregar o seleccionar mesas</small>
    </div>
    <div class="wizard-line"></div>
    <div class="wizard-step" data-plantillas-target="stepIndicator">
      <span>3</span>
      <small>Agregar horarios a las mesas</small>
    </div>
    <div class="wizard-line"></div>
    <div class="wizard-step" data-plantillas-target="stepIndicator">
      <span>4</span>
      <small>Agregar o seleccionar días</small>
    </div>
    <div class="wizard-line"></div>
    <div class="wizard-step" data-plantillas-target="stepIndicator">
      <span>5</span>
      <small>Confirmar</small>
    </div>
  </div>
  <%= form_with model: @plantilla,id: "plantilla-form" do |f| %>
    <!-- PASO 1 -->
    <div class="wizard-page active" data-plantillas-target="page">
      <div class="wizard-header">
        <p>Nombre de la Plantilla</p>
      </div>
      <div class="form-group">
        <%= f.text_field :nombre, class: "form-control" %>
      </div>
      <div class="wizard-actions">
        <button type="button"
                class="btn-siguiente"
                data-action="click->plantillas#siguiente">
          Siguiente
          <i class="bi bi-arrow-right"></i>
        </button>
      </div>
    </div>
    <!-- PASO 2 -->
    <div class="wizard-page" data-plantillas-target="page">
      <div class="wizard-header">
        <h2>Configuración de mesas</h2>
      </div>
      <%= turbo_frame_tag "lista_mesas" do %>
        <div class="mesas-lista" id="mesas_lista">
          <% if @mesas.any? %>
            <%= render "lista_de_mesas", mesa: @mesa %>
          <% else %>
            <div class="mesas-vacio">
              <h3>No hay mesas registradas</h3>
              <p>
                Agrega una mesa para comenzar.
              </p>
            </div>
          <% end %>
        </div>
      <% end %>
      <div class="wizard-actions">
        <button type="button"
                class="btn-atras"
                data-action="click->plantillas#anterior">
          <i class="bi bi-arrow-left"></i>
          Atrás
        </button>
        <button type="button"
                class="btn-siguiente"
                data-action="click->plantillas#siguientePaso3">
          Siguiente
          <i class="bi bi-arrow-right"></i>
        </button>
      </div>
    </div>
    <!-- PASO 3 -->
    <div class="wizard-page" data-plantillas-target="page">
      <div class="mesas-container">
        <div class="mesas-header">
          <div class="hstack gap-2">
            <h2>
              <i class="bi bi-grid-3x3-gap-fill"></i>
              Agregar Horario
            </h2>            
          </div>
        </div>
      </div>
      <br>      
      <div id="agregar_nuevos_horarios">
      </div>
      <div class="wizard-actions">
        <button type="button"
                class="btn-atras"
                data-action="click->plantillas#anterior">
          <i class="bi bi-arrow-left"></i>
          Atrás
        </button>
        <button type="button"
                class="btn-siguiente"
                data-action="click->plantillas#siguientePaso4">
          Siguiente
          <i class="bi bi-arrow-right"></i>
        </button>
      </div>
    </div>
    <!-- PASO 4 -->
    <div class="wizard-page" data-plantillas-target="page">
      <div class="wizard-header">
        <h2>Configuración de días</h2>
        <p>Estas son las mesas seleccionadas.</p>
      </div>
      <br>
      <div id="turbo_mesas_seleccionadas">
      </div>
      <div class="wizard-actions">
        <button type="button"
            class="btn-atras"
            data-action="click->plantillas#anterior">
          <i class="bi bi-arrow-left"></i>
          Atrás
        </button>
        <button type="button"
            class="btn-siguiente"
            data-action="click->plantillas#siguiente">
          Siguiente
          <i class="bi bi-arrow-right"></i>
        </button>
      </div>
    </div>
    <!-- PASO 4 -->
    <div class="wizard-page" data-plantillas-target="page">
      <div class="wizard-header">
        <h2>Confirmar información</h2>
        <p>Revisa los datos antes de guardar.</p>
      </div>
      <div class="confirmacion">
        <i class="bi bi-check-circle-fill"></i>
        <h3>Todo listo</h3>
        <p>
          Revisa que la información de las mesas sea correcta.
        </p>
      </div>
      <button type="button" class="btn-atras" data-action="click->plantillas#anterior">
        <i class="bi bi-arrow-left"></i>
        Atrás
      </button>
      <%= f.submit "Guardar Plantilla",class: "btn-guardar" %>
    </div>
  <% end %>
</div>