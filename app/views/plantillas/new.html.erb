<div class="wizard"  data-controller="plantillas">
  <!-- Indicador de pasos -->
  <div class="wizard-steps">
    <div class="wizard-step active" data-plantillas-target="stepIndicator">
      <span>1</span>
      <small>Nombre de la Plantilla</small>
    </div>
    <div class="wizard-line"></div>
    <div class="wizard-step" data-plantillas-target="stepIndicator">
      <span>2</span>
      <small>Agregar o seleccionar mesas</small>
    </div>
    <div class="wizard-line"></div>
    <div class="wizard-step" data-plantillas-target="stepIndicator">
      <span>3</span>
      <small>Agregar o seleccionar días</small>
    </div>
    <div class="wizard-line"></div>
    <div class="wizard-step" data-plantillas-target="stepIndicator">
      <span>4</span>
      <small>Confirmar</small>
    </div>
  </div>
  <%= form_with model: @agenda do |f| %>
    <!-- PASO 1 -->
    <div class="wizard-page active" data-plantillas-target="page">
      <div class="wizard-header">
        <p>Nombre de la Plantilla</p>
      </div>
      <div class="form-group">
        <%= f.text_field :nombre, class: "form-control" %>
      </div>
      <div class="wizard-actions">
        <button type="button"
                class="btn-siguiente"
                data-action="click->plantillas#siguiente">
          Siguiente
          <i class="bi bi-arrow-right"></i>
        </button>
      </div>
    </div>
    <!-- PASO 2 -->
    <div class="wizard-page" data-plantillas-target="page">
      <div class="wizard-header">
        <h2>Configuración de mesas</h2>
      </div>
      <div class="mesas-container">
        <div class="mesas-header">
          <div class="hstack gap-2">
            <h2>
              <i class="bi bi-grid-3x3-gap-fill"></i>
              Mesas
            </h2>
            <%= link_to new_mesa_path,
            class: "btn-agregar-mesa",
            data: { turbo_frame: "modal" } do %>
              <i class="bi bi-plus-circle-fill"></i>
              <span>Agregar mesa</span>
            <% end %>
          </div>
        </div>
      </div>
      <br>
      <%= turbo_frame_tag "modal" %>
      <%= turbo_frame_tag "lista_mesas" do %>
        <div class="mesas-lista" id="mesas_lista">
          <% if @mesas.any? %>
            <%= render "lista_de_mesas", mesa: @mesa %>
          <% else %>
            <div class="mesas-vacio">
              <h3>No hay mesas registradas</h3>
              <p>
                Agrega una mesa para comenzar.
              </p>
            </div>
          <% end %>
        </div>
      <% end %>
      <div class="wizard-actions">
        <button type="button"
                class="btn-atras"
                data-action="click->plantillas#anterior">
          <i class="bi bi-arrow-left"></i>
          Atrás
        </button>
        <button type="button"
                class="btn-siguiente"
                data-action="click->plantillas#siguiente">
          Siguiente
          <i class="bi bi-arrow-right"></i>
        </button>
      </div>
    </div>
    <!-- PASO 3 -->
    <!-- PASO 3 -->
    <div class="wizard-page" data-plantillas-target="page">
      <div class="wizard-header">
        <h2>Configuración de días</h2>
        <p>Selecciona qué mesa utilizarás cada día.</p>
      </div>
      <div class="dias-container">
        <!-- LUNES -->
        <div class="dia-item">
          <div class="dia-info">
            <i class="bi bi-calendar-day"></i>
            <div>
              <strong>Lunes</strong>
              <small>Selecciona una mesa</small>
            </div>
          </div>
          <%= select_tag "agenda[dias][lunes][mesa_id]",
            options_from_collection_for_select(
              @mesas_seleccionadas,
              :id,
              :nombre
            ),
            include_blank: "Selecciona una mesa",
            class: "form-select" %>
        </div>
        <!-- MARTES -->
        <div class="dia-item">
          <div class="dia-info">
            <i class="bi bi-calendar-day"></i>
            <div>
              <strong>Martes</strong>
              <small>Selecciona una mesa</small>
            </div>
          </div>
          <%= select_tag "agenda[dias][martes][mesa_id]",
            options_from_collection_for_select(
              @mesas_seleccionadas,
              :id,
              :nombre
            ),
            include_blank: "Selecciona una mesa",
            class: "form-select" %>
        </div>
        <!-- MIÉRCOLES -->
        <div class="dia-item">
          <div class="dia-info">
            <i class="bi bi-calendar-day"></i>
            <div>
              <strong>Miércoles</strong>
              <small>Selecciona una mesa</small>
            </div>
          </div>
          <%= select_tag "agenda[dias][miercoles][mesa_id]",
            options_from_collection_for_select(
              @mesas_seleccionadas,
              :id,
              :nombre
            ),
            include_blank: "Selecciona una mesa",
            class: "form-select" %>
        </div>
        <!-- JUEVES -->
        <div class="dia-item">
          <div class="dia-info">
            <i class="bi bi-calendar-day"></i>
            <div>
              <strong>Jueves</strong>
              <small>Selecciona una mesa</small>
            </div>
          </div>
          <%= select_tag "agenda[dias][jueves][mesa_id]",
            options_from_collection_for_select(
              @mesas_seleccionadas,
              :id,
              :nombre
            ),
            include_blank: "Selecciona una mesa",
            class: "form-select" %>
        </div>
        <!-- VIERNES -->
        <div class="dia-item">
          <div class="dia-info">
            <i class="bi bi-calendar-day"></i>
            <div>
              <strong>Viernes</strong>
              <small>Selecciona una mesa</small>
            </div>
          </div>
          <%= select_tag "agenda[dias][viernes][mesa_id]",
            options_from_collection_for_select(
              @mesas_seleccionadas,
              :id,
              :nombre
            ),
            include_blank: "Selecciona una mesa",
            class: "form-select" %>
        </div>
      </div>
      <div class="wizard-actions">
        <button type="button"
            class="btn-atras"
            data-action="click->plantillas#anterior">
          <i class="bi bi-arrow-left"></i>
          Atrás
        </button>
        <button type="button"
            class="btn-siguiente"
            data-action="click->plantillas#siguiente">
          Siguiente
          <i class="bi bi-arrow-right"></i>
        </button>
      </div>
    </div>
    <!-- PASO 4 -->
    <div class="wizard-page" data-plantillas-target="page">
      <div class="wizard-header">
        <h2>Confirmar información</h2>
        <p>Revisa los datos antes de guardar.</p>
      </div>
      <div class="confirmacion">
        <i class="bi bi-check-circle-fill"></i>
        <h3>Todo listo</h3>
        <p>
          Revisa que la información de las mesas sea correcta.
        </p>
      </div>
      <div class="wizard-actions">
        <button type="button"
                class="btn-atras"
                data-action="click->plantillas#anterior">
          <i class="bi bi-arrow-left"></i>
          Atrás
        </button>
        <%= f.submit "Guardar agenda",
            class: "btn-guardar" %>
      </div>
    </div>
  <% end %>
</div>