<%= turbo_stream.replace "renglones_ref" do %>
  <div id="renglones_ref" class="relacion-medicos">
    <div class="relacion-section-header">
      <!-- Dias -->
      <div class="relacion-field">
        <label from="detalles_id">Dias</label>
        <select id="dias" name="dias" class="form-select">
          <option selected value="" disabled >Selecciona un dia</option>
          <% dias.each do |det|%>
            <option value="<%=det[:dias]+"_"+det[:num]%>"><%= det[:dias]+" - "+det[:num].to_s %></option>
          <% end %>
        </select>
      </div>     
    </div>
  </div>
<% end %>