<div class="relacion-container" data-controller="relacion-agenda">
  <div class="relacion-header">
    <div>
      <h1>
        <i class="bi bi-link-45deg"></i>
        Agendar médicos
      </h1>
      <p>
        Selecciona la agenda, plantilla y médicos que participarán.
      </p>
    </div>
  </div>
  <div class="relacion-card">
    <%= form_with model: @relacion_agenda do |form| %>
      <!-- Agenda -->
      <div class="agenda-periodo-preview ">
        <div class="d-flex align-items-center gap-3">
          <div class="agenda-preview-icon">
            <i class="bi bi-calendar-check"></i>
          </div>
          <div>
            <span class="agenda-preview-label">
              Periodo de vigencia
            </span>
            <h5 class="mb-0" data-relacion-agenda-target="periodo">
              <%= (@agenda.fecha_inicio || Date.current).beginning_of_month.strftime("%d/%m/%Y") %>
              —
              <%= (@agenda.fecha_inicio || Date.current).end_of_month.strftime("%d/%m/%Y") %>
            </h5>
          </div>
        </div>
        <div class="agenda-preview-divider"></div>
        <div class="d-flex justify-content-between align-items-center">
          <span class="text-muted">
            Duración del periodo
          </span>
          <strong data-relacion-agenda-target="dias">
            <%= (@agenda.fecha_inicio || Date.current).end_of_month.day %> días
          </strong>
        </div>
        <br>
        <div class="d-flex justify-content-between align-items-center">
          <div class="estado-agenda <%= @plantilla.activo==true ? 'activo' : 'inactivo' %>">
            <span class="text-muted">
              Plantilla: <%= @plantilla.nombre %>  Activa:
            </span>
            <% if @plantilla.activo? %>
              <span> <i class="bi bi-check-circle-fill "></i></span>
              <%= form.hidden_field :plantilla_id,value:@plantilla.id,id: :plantilla_id %>
            <% else %>
              <span>    <i class="bi bi-x-circle-fill"> </i></span>
              <%= form.hidden_field :plantilla_id,value:0,id: :plantilla_id %>
            <% end %>
          </div>
        </div>
      </div>
      <%= form.hidden_field :agenda_id,value:@agenda.id,id: :agenda_id %>
      <br>
      <div class="container mt-4" data-relacion-agenda-url-value="<%= dias_disponibles_relacion_agenda_plantillas_path %>">
        <!-- ACCIONES -->
        <div class="container" data-relacion-agenda-url-value="<%= dias_disponibles_relacion_agenda_plantillas_path %>">
          <h3>Asignación de médico</h3>
          <div class="row mb-4">
            <div class="col-md-6">
              <%= render "medicos_select" %>
              <%# select_tag :medico_id,options_from_collection_for_select(@medicos, :id, :nombre),prompt: "Selecciona un médico",        class: "form-select"              %>
            </div>
            <div class="col-md-6">
              <%= turbo_frame_tag "mesas_ref" do %>
              <% end %>
            </div>
          </div>
          <div class="calendario-container">
            <div class="calendario-header">
              <div>
                <h3 data-relacion-agenda-target="titulo"></h3>
                <span>Selecciona los días que deseas asignar</span>
              </div>
              <div class="calendario-navegacion">
                <button type="button" class="btn btn-outline-success" data-action="click->relacion-agenda#seleccionarTodos">
                  <i class="bi bi-check2-all"></i>
                  Seleccionar todos
                </button>
                <button type="button" class="btn btn-outline-secondary" data-action="click->relacion-agenda#limpiarSeleccion">
                  <i class="bi bi-x-circle"></i>
                  Limpiar selección
                </button>
              </div>
            </div>
            <div class="calendario-dias-semana">
              <% %w[Lunes Martes Miércoles Jueves Viernes Sábado Domingo].each do |dia| %>
                <div><%= dia %></div>
              <% end %>
            </div>
            <div class="calendario-grid"
         data-relacion-agenda-target="calendario">
            </div>
            <div data-relacion-agenda-target="seleccionados"></div>
            <div class="calendario-leyenda">
              <span><i class="disponible"></i> Disponible</span>
              <span><i class="seleccionado"></i> Seleccionado</span>
              <span><i class="bloqueado"></i> No disponible</span>
            </div>
          </div>
        </div>
        <!-- DÍAS -->
        <div class="relacion-actions">
          <%= link_to agendas_path,
            class: "btn-relacion-secondary" do %>
            <i class="bi bi-x-lg"></i>
            Cancelar
          <% end %>
          <%= form.submit "Guardar relación",
            class: "btn-relacion-primary" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
<div id="notificaciones">
</div>