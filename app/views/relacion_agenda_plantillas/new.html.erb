<div class="relacion-container" data-controller="agenda">
  <div class="relacion-header">
    <div>
      <h1>
        <i class="bi bi-link-45deg"></i>
        Relacionar agenda
      </h1>
      <p>
        Selecciona la agenda, plantilla y médicos que participarán.
      </p>
    </div>
  </div>
  <div class="relacion-card">
    <%= form_with model: @relacion_agenda do |form| %>
      <div class="relacion-fields">
        <!-- Agenda -->
        <div class="relacion-field">
          <%= form.label :agenda_id, "Agenda" %>
          <p><%="#{@agenda.fecha_inicio} - #{@agenda.fecha_fin}"%></p>
          <%= form.hidden_field :agenda_id,value:@agenda.id %>
        </div>
        <!-- Plantilla -->
        <div class="relacion-field">
          <%= form.label :plantilla_id, "Plantilla" %>
          <%= form.collection_select :plantilla_id,
              Plantilla.all,
              :id,
              :nombre,
              { prompt: "Selecciona una plantilla" },
              { class: "form-select" } %>
        </div>
      </div>
      <br>
        <div class="container mt-4"
     data-controller="asignaciones"
     data-asignaciones-url-value="<%= dias_disponibles_asignaciones_path %>">
  <div class="card shadow-sm">
    <div class="card-header">
      <h4>Asignación de médicos</h4>
    </div>
    <div class="card-body">
      <div class="row mb-4">
        <div class="col-md-6">
          <label class="form-label">Médico</label>
          <%= select_tag :relacion_agenda_plantilla_id,
            options_from_collection_for_select(
              @relaciones,
              :id,
              ->(r) { r.user.nombre_completo }
            ),
            prompt: "Selecciona un médico",
            class: "form-select",
            data: {
              asignaciones_target: "medico",
              action: "change->asignaciones#cambiarMedico"
            } %>
        </div>
        <div class="col-md-6">
          <label class="form-label">Mesa</label>
          <%= select_tag :mesa_id,
            options_from_collection_for_select(
              @mesas,
              :id,
              :nombre_mesa
            ),
            prompt: "Selecciona una mesa",
            class: "form-select",
            data: {
              asignaciones_target: "mesa",
              action: "change->asignaciones#cargarDias"
            } %>
        </div>
      </div>
      <div class="calendario-asignaciones">
        <h5 class="mb-3">Días de asignación</h5>
        <div class="calendario-grid">
          <% @dias_semana.each do |dia| %>
            <label class="dia-card disabled"
                   data-asignaciones-target="dia"
                   data-dia="<%= dia %>">
              <input type="checkbox"
                     name="asignaciones[dias][]"
                     value="<%= dia %>"
                     disabled>
              <span class="dia-nombre">
                <%= dia.capitalize %>
              </span>
              <span class="dia-estado">
                No disponible
              </span>
            </label>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
      <!-- ACCIONES -->
      <div class="relacion-actions">
        <%= link_to agendas_path,
            class: "btn-relacion-secondary" do %>
          <i class="bi bi-x-lg"></i>
          Cancelar
        <% end %>
        <%= form.submit "Guardar relación",
            class: "btn-relacion-primary" %>
      </div>
    <% end %>
  </div>
  <div class="agenda-relaciones">
    <div class="agenda-relaciones-header">
      <h3>Relaciones de la agenda</h3>
    </div>
    <div class="agenda-relaciones-lista">
      <% @agenda.relacion_agenda_plantillas.each do |relacion| %>
        <div class="agenda-relacion">
          <!-- Plantilla -->
          <div class="agenda-relacion-seccion">
            <span class="agenda-relacion-label">
              Plantilla
            </span>
            <div class="agenda-relacion-valor">
              <i class="bi bi-file-earmark-text"></i>
              <%= relacion.plantilla.nombre %>
            </div>
          </div>
          <!-- Usuario -->
          <div class="agenda-relacion-seccion">
            <span class="agenda-relacion-label">
              Responsable
            </span>
            <div class="agenda-relacion-valor">
              <i class="bi bi-person"></i>
              <%= relacion.user.nombre %>
            </div>
          </div>
          <!-- Día -->
          <div class="agenda-relacion-seccion">
            <span class="agenda-relacion-label">
              Día
            </span>
            <div class="agenda-relacion-valor">
              <i class="bi bi-calendar3"></i>
              <%= relacion.dia_nombre %>
              <%= relacion.dia %>
            </div>
          </div>
          <div class="agenda-relacion-seccion ">
            <span class="agenda-relacion-label">
              Mesa
            </span>
            <div class="agenda-relacion-valor">
              <%= relacion.detalle_plantilla.mesa.nombre_mesa %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>