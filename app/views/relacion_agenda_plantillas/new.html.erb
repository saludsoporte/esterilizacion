<div class="relacion-container" data-controller="agenda">
  <div class="relacion-header">
    <div>
      <h1>
        <i class="bi bi-link-45deg"></i>
        Relacionar agenda
      </h1>
      <p>
        Selecciona la agenda, plantilla y médicos que participarán.
      </p>
    </div>
  </div>
  <div class="relacion-card">
    <%= form_with model: @relacion_agenda do |form| %>
      <div class="relacion-fields">
        <!-- Agenda -->
        <div class="relacion-field">
          <%= form.label :agenda_id, "Agenda" %>
          <p><%="#{@agenda.fecha_inicio} - #{@agenda.fecha_fin}"%></p>
          <%= form.hidden_field :agenda_id,value:@agenda.id %>
        </div>
        <!-- Plantilla -->
        <div class="relacion-field">
          <%= form.label :plantilla_id, "Plantilla" %>
          <%= form.collection_select :plantilla_id,
              Plantilla.all,
              :id,
              :nombre,
              { prompt: "Selecciona una plantilla" },
              { class: "form-select",id: "plantilla_id" } %>
        </div>
      </div>
      <br>
      <div class="container mt-4" data-agenda-url-value="<%= dias_disponibles_relacion_agenda_plantillas_path %>">
        <!-- ACCIONES -->
        <div class="container" data-agenda-url-value="<%= dias_disponibles_relacion_agenda_plantillas_path %>">
          <h3>Asignación de médico</h3>
          <div class="row mb-4">
            <div class="col-md-6">
              <label>Médico</label>
              <%= select_tag :medico_id,options_from_collection_for_select(@medicos, :id, :nombre),prompt: "Selecciona un médico",        class: "form-select"
              %>
            </div>
            <div class="col-md-6">
              <%= turbo_frame_tag "mesas_ref" do %>
              <% end %>
            </div>
          </div>
          <div class="calendario-container">
            <div class="calendario-header">
              <div>
                <h3 data-agenda-target="titulo"></h3>
                <span>Selecciona los días que deseas asignar</span>
              </div>
              <div class="calendario-navegacion">
                <button type="button" class="btn btn-outline-success" data-action="click->agenda#seleccionarTodos">
                  <i class="bi bi-check2-all"></i>
                  Seleccionar todos
                </button>
                <button type="button" class="btn btn-outline-secondary" data-action="click->agenda#limpiarSeleccion">
                  <i class="bi bi-x-circle"></i>
                  Limpiar selección
                </button>
              </div>
            </div>
            <div class="calendario-dias-semana">
              <% %w[Lunes Martes Miércoles Jueves Viernes Sábado Domingo].each do |dia| %>
                <div><%= dia %></div>
              <% end %>
            </div>
            <div class="calendario-grid"
         data-agenda-target="calendario">
            </div>
            <div data-agenda-target="seleccionados"></div>
            <div class="calendario-leyenda">
              <span><i class="disponible"></i> Disponible</span>
              <span><i class="seleccionado"></i> Seleccionado</span>
              <span><i class="bloqueado"></i> No disponible</span>
            </div>
          </div>
        </div>
        <!-- DÍAS -->
        <div class="relacion-actions">
          <%= link_to agendas_path,
            class: "btn-relacion-secondary" do %>
            <i class="bi bi-x-lg"></i>
            Cancelar
          <% end %>
          <%= form.submit "Guardar relación",
            class: "btn-relacion-primary" %>
        </div>
      </div>
    <% end %>
  </div>
  <div class="agenda-relaciones">
    <div class="agenda-relaciones-header">
      <h3>Relaciones de la agenda</h3>
    </div>
    <div class="agenda-relaciones-lista">
      <% @agenda.relacion_agenda_plantillas.each do |relacion| %>
        <div class="agenda-relacion">
          <!-- Plantilla -->
          <div class="agenda-relacion-seccion">
            <span class="agenda-relacion-label">
              Plantilla
            </span>
            <div class="agenda-relacion-valor">
              <i class="bi bi-file-earmark-text"></i>
              <%= relacion.plantilla.nombre %>
            </div>
          </div>
          <!-- Usuario -->
          <div class="agenda-relacion-seccion">
            <span class="agenda-relacion-label">
              Responsable
            </span>
            <div class="agenda-relacion-valor">
              <i class="bi bi-person"></i>
              <%= relacion.user.nombre %>
            </div>
          </div>
          <!-- Día -->
          <div class="agenda-relacion-seccion">
            <span class="agenda-relacion-label">
              Día
            </span>
            <div class="agenda-relacion-valor">
              <i class="bi bi-calendar3"></i>
              <%= relacion.dia_nombre %>
              <%= relacion.dia %>
            </div>
          </div>
          <div class="agenda-relacion-seccion ">
            <span class="agenda-relacion-label">
              Mesa
            </span>
            <div class="agenda-relacion-valor">
              <%= relacion.detalle_plantilla.mesa.nombre_mesa %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>